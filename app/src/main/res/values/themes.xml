<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LumeTime" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="colorAccent">@color/accent_cyan</item>
        <item name="android:windowBackground">@color/bg_base</item>
    </style>

    <style name="Theme.LumeTime.GlassDialog" parent="Theme.AppCompat.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.50</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>
